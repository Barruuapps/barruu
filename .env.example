# Barruu Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# App Configuration
APP_NAME=Barruu
APP_ENV=development

# API Configuration (future use)
# API_BASE_URL=https://api.barruu.com
# API_KEY=your_api_key_here

# Storage Configuration
# CLOUD_STORAGE_ENDPOINT=https://storage.barruu.com
# CLOUD_STORAGE_BUCKET=barruu-assets
# CLOUD_STORAGE_ACCESS_KEY=your_access_key
# CLOUD_STORAGE_SECRET_KEY=your_secret_key

# Feature Flags
ENABLE_AI_FEATURES=false
ENABLE_CLOUD_SYNC=false
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# Logging
LOG_LEVEL=debug