# Barruu Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─────────────────────────────────────────────
# AI API
# ─────────────────────────────────────────────
DEEP_SEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com

# ─────────────────────────────────────────────
# BIPY Encryption
# ─────────────────────────────────────────────
# 32-character key used for encrypting .bipy files.
# Must be identical across all app installations so files can
# be opened on any device running Barruu.
BARRUU_BIPY_KEY=your-32-character-encryption-key

# Comma-separated legacy keys for backward compatibility with
# .bipy files created by older/differently-configured builds.
# BARRUU_BIPY_LEGACY_KEYS=old_key_1,old_key_2

# ─────────────────────────────────────────────
# Storage (Cloudflare R2)
# ─────────────────────────────────────────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-custom-domain.com

# ─────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────
ENABLE_AI_FEATURES=false
ENABLE_CLOUD_SYNC=false
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=debug