# EditorConfig for Barruu
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,yaml,yml}]
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{swift}]
indent_style = space
indent_size = 4

[*.{md,rst}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{gradle,java,xml}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{json,html,css,js}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = tab